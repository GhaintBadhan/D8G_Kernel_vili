name:Zstd

on:
  workflow_dispatch:
    inputs:
      source_repo:
        description: 'https://github.com/Spanish-or-Vanish/kernel_xiaomi_sm8350/tree/lineage-24.0'
        required: true
        default: 'https://github.com/GhaintBadhan/D8G_Kernel_vili/new/13'
      folder_path:
        description: 'lib/zstd'
        required: true
        default: 'lib/'

jobs:
  transfer:
    runs-on: ubuntu-latest
    permissions:
      contents: write # Allows the action to commit and push changes back to the repo

    steps:
      - name: Checkout Destination Repo
        uses: actions/checkout@v4

      - name: Clone Source and Copy Folder
        run: |
          # Clone the source repository into a temporary folder
          git clone ${{ github.event.inputs.source_repo }} /tmp/source-repo
          
          # Create target directory if it doesn't exist
          mkdir -p $(dirname "${{ github.event.inputs.folder_path }}")
          
          # Copy the specified folder over
          cp -r /tmp/source-repo/${{ github.event.inputs.folder_path }} ${{ github.event.inputs.folder_path }}

      - name: Commit and Push to Destination
        run: |
          git config --global user.name "GitHub Actions Bot"
          git config --global user.email "actions@github.com"
          
          git add "${{ github.event.inputs.folder_path }}"
          
          # Check if there are changes to commit
          if git diff --staged --quiet; then
            echo "No changes to commit."
          else
            git commit -m "chore: copy folder from source repository online"
            git push
            echo "Successfully pushed folder to repository!"
          fi
